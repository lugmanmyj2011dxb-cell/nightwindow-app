{
  "hosting": {
    "public": "hosting-public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [{
      "source": "**/*.mp4",
      "headers": [{
        "key": "Content-Type",
        "value": "video/mp4"
      }]
    }, {
      "source": "**/*.json",
      "headers": [{
        "key": "Content-Type",
        "value": "application/json"
      }, {
        "key": "Cache-Control",
        "value": "public, max-age=3600"
      }]
    }]
  }
}
