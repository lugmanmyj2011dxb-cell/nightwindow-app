{
  "appId": "com.lugman.nightwindow",
  "appName": "Sleep Window",
  "webDir": "www",
  "backgroundColor": "#0c0e13",
  "android": {
    "backgroundColor": "#0c0e13",
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "backgroundColor": "#0c0e13",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    },
    "FirebaseAuthentication": {
      "skipNativeAuth": true
    }
  }
}
