rules_version = '2';

// ===================== 眠窗 · Firestore 安全规则 =====================
// 默认拒绝所有客户端直接读写。这张 memberships 表现在只有一个用途：
// functions/index.js 里的云函数用 Firebase Admin SDK 写入——Admin SDK 走的是
// 独立的管理员权限通道，不受这份规则约束，所以这里全部拒绝客户端访问也完全不影响
// webhook 正常工作。
//
// 为什么默认全部拒绝，而不是开放读：这张表存的是会员资格记录，一旦允许任何客户端
// 直接读取，等于任何人都能查到"某个 RevenueCat app_user_id 是不是会员"，虽然这个
// app_user_id 本身不直接等于某个可识别的真人，但仍然是不必要的信息暴露面，能不开
// 就不开——等以后做账号系统、需要让已登录用户查自己的会员状态时，再加一条"只允许
// 查自己那一条记录"的规则（用 Firebase Auth 的 uid 做身份校验），不要图方便直接开放。
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
